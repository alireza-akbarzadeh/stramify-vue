# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# Every value here is a PLACEHOLDER. This file is committed, so a real
# credential put here is published — it was, once (commit a96adb9 shipped a
# live Neon password and better-auth key to a public repo). Keep it that way:
# if a value would still work when pasted somewhere else, it does not belong
# in this file.

NODE_ENV=development

# --- App -----------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 3 — required for auth to function) ------------------
# Any Postgres connection string. Neon, Supabase, or local docker.
DATABASE_URL=postgresql://user:password@host:5432/streamify?sslmode=require

# --- Auth (Phase 3 — better-auth, ADR-007) --------------------------------
# Generate with: openssl rand -base64 32
# The name matters: server/utils/auth.ts and nuxt.config.ts both read
# BETTER_AUTH_SECRET. This was BETTER_AUTH_API_KEY until 2026-09-08, which
# meant a .env copied straight from this template left better-auth with
# `secret: undefined`.
BETTER_AUTH_SECRET=

# --- Redis (Phase 7/8 — realtime chat & viewer counts, ADR-006) ----------
REDIS_URL=redis://localhost:6379

# --- Cloudflare Stream (Phase 7 — video, ADR-005) -------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Cloudflare R2 (Phase 6/9 — object storage, avatars/thumbnails) -------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# --- Observability (Phase 12 — error tracking) ----------------------------
SENTRY_DSN=


# AUTH KEYS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GEMINI_API_KEY=AIzaSyDa-BLYkSK81TtHAf9o4YriXPIz9boyHxw