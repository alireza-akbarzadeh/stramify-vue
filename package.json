{
  "name": "streamify",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npm run db:seed:clips && npm run db:seed:shorts && npm run db:seed:live && npm run db:seed:channels && npm run db:seed:follows && npm run db:seed:comments && npm run db:seed:chat",
    "db:seed:clips": "node --env-file=.env scripts/seed-clips.mjs",
    "db:seed:shorts": "node --env-file=.env scripts/seed-shorts.mjs",
    "db:seed:live": "node --env-file=.env scripts/seed-live-streams.mjs",
    "db:seed:channels": "node --env-file=.env scripts/seed-channels.mjs",
    "db:seed:follows": "node --env-file=.env scripts/seed-follows.mjs",
    "db:seed:comments": "node --env-file=.env scripts/seed-comments.mjs",
    "db:seed:chat": "node --env-file=.env scripts/seed-chat.mjs"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.31.0",
    "@pinia/nuxt": "^1.0.1",
    "@tanstack/vue-query": "^5.101.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "motion-v": "^2.3.0",
    "nuxt": "^4.5.1",
    "pinia": "^4.0.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vidstack": "^1.15.6",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "zod": "$zod"
  }
