# @vee-validate/zod still declares `peerDependencies: { zod: "^3.24.0" }` even on
# its latest release (4.15.1), but this project is on Zod 4 and cannot go back —
# better-auth requires `zod >=4.1.12`. The adapter itself works fine against
# Zod 4 at runtime; only its published peer range is stale.
#
# Without this flag npm treats that stale range as a hard conflict and fails
# EVERY install in this repo (including `npx shadcn-vue add ...`, which shells
# out to `npm install`), not just ones touching zod.
#
# The matching `overrides.zod` pin in package.json is the other half of this:
# it stops anything — notably the shadcn-vue CLI, which hardcodes zod@3.25.76 —
# from quietly pulling Zod 3 back in now that peer conflicts are non-fatal.
legacy-peer-deps=true
shamefully-hoist=true